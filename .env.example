# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# EMAIL & SMTP CONFIGURATION
# For Gmail: set GMAIL_USER and GMAIL_APP_PASSWORD (16-char app password from https://myaccount.google.com/apppasswords)
# Do NOT commit credentials or enclose values in quotes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or standard Custom SMTP Provider:
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Muthamizh Academy Admissions <admissions@muthamizh.ac.in>"

# Institutional Faculty Invitation Master Key (Optional fallback; single-use hashed invites are preferred)
FACULTY_INVITE_KEY=

